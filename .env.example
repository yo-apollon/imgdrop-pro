# ==========================================
# CONFIGURAÇÕES DE HOSPEDAGEM & CLOUD STORAGE
# ==========================================

# 1. VERCEL BLOB (Recomendado para Vercel - Ativado com 1 clique no painel da Vercel)
# Ao adicionar Vercel Blob no dashboard, esta variável é injetada automaticamente:
BLOB_READ_WRITE_TOKEN=

# 2. CLOUDFLARE R2 (Alternativa com Custo Zero de Tráfego/Egress)
# Obtenha em: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<seu-account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<seu-hash>.r2.dev

# 3. URL DA APLICAÇÃO
NEXT_PUBLIC_APP_URL=https://meu-imagetourl.vercel.app

# ==========================================
# MONETIZAÇÃO & GATEWAYS DE PAGAMENTO
# ==========================================
# Stripe (Internacional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago / Asaas (PIX Brasil)
MERCADO_PAGO_ACCESS_TOKEN=
